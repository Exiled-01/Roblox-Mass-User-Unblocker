{
  "manifest_version": 3,
  "name": "Roblox Mass User Unblocker",
  "version": "1.2.2",
  "description": "Safely mass unblock users from your Roblox blocked list with rate limiting",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://users.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/my/account*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["options.html"],
      "matches": ["https://www.roblox.com/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }

}
